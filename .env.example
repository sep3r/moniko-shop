# نمونه‌ی تنظیمات محیطی. این فایل را به .env کپی کنید و مقدارها را پر کنید (.env هرگز commit نمی‌شود).
# رمزهای تصادفی قوی:  ./scripts/gen-secrets.sh

POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_EMAIL=admin@monikoshop.ir
ADMIN_PASSWORD=
# شماره‌ی موبایل مدیر (برای ورود با شماره و بازیابی رمز با پیامک)
ADMIN_PHONE=

# --- پیامک کد تأیید (کاوه‌نگار) ---
KAVENEGAR_API_KEY=
# نام قالب تأییدیه در پنل کاوه‌نگار، مثل registerverify (متن قالب: ... %token ...)
KAVENEGAR_TEMPLATE=
# راز HMAC کدهای پیامکی (حداقل ۱۶ کاراکتر تصادفی)
OTP_HASH_SECRET=
# فقط تست محلی بدون پنل کاوه‌نگار: کد در لاگ backend چاپ می‌شود. در production false.
KAVENEGAR_DEV_LOG_CODES=false

# --- اختیاری ---
# دامنه‌ی اصلی سایت و API (برای sitemap و صفحات سئو). پیش‌فرض: APP_BASE_URL یا https://moniko.ir
# SITE_URL=https://moniko.ir
# API_PUBLIC_URL=https://api.moniko.ir
# بکاپ خودکار (docker compose --profile backup up -d db-backup)
# BACKUP_KEEP_DAYS=14
# BACKUP_INTERVAL_HOURS=24

# سقف سفارش «در انتظار» برای هر کاربر (پیش‌فرض 5)
# ORDER_MAX_PENDING=5
# مدت نگهداری لاگ IP بازدیدها و رویدادهای امنیتی (روز)
# VISIT_LOG_RETENTION_DAYS=90
# AUDIT_RETENTION_DAYS=365

# مدت نشست وقتی کاربر «مرا به خاطر بسپار» را می‌زند (میلی‌ثانیه؛ پیش‌فرض ۳ روز)
# JWT_REMEMBER_EXPIRATION=259200000
