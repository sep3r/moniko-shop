{
  "buildCommand": "npm install --include=dev && node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
  "installCommand": "npm install --include=dev",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.moniko.ir/api/sitemap.xml"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|Bingbot|BingPreview|YandexBot|Baiduspider|DuckDuckBot|Applebot|TelegramBot|WhatsApp|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|Discordbot|Embedly).*"
        }
      ],
      "destination": "https://api.moniko.ir/api/seo/home"
    },
    {
      "source": "/products/:id(\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|Bingbot|BingPreview|YandexBot|Baiduspider|DuckDuckBot|Applebot|TelegramBot|WhatsApp|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|Discordbot|Embedly).*"
        }
      ],
      "destination": "https://api.moniko.ir/api/seo/products/:id"
    },
    {
      "source": "/categories/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|Bingbot|BingPreview|YandexBot|Baiduspider|DuckDuckBot|Applebot|TelegramBot|WhatsApp|facebookexternalhit|Twitterbot|LinkedInBot|Slackbot|Discordbot|Embedly).*"
        }
      ],
      "destination": "https://api.moniko.ir/api/seo/categories/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://api.moniko.ir; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        }
      ]
    }
  ]
}
